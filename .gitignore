# Build artifacts
*.o
*.a
*.so
*.dylib

# CMake out-of-source build
build/
cmake-build-*/

# Which mode the objects were built in; see the Makefile, .build-mode.
.build-mode

# Test and example executables (carry the _cpp suffix, per the coding convention)
*_cpp

# macOS
.DS_Store
._*

# Editors
*.swp
*.swo
*~
.vscode/
.idea/

# Python (the prototype twins in experiments/ordering; see CLAUDE.md, Tooling).
# No pyproject.toml and no venv today, the layers being stdlib-only scripts run
# by a bare python3, but bytecode appears as soon as one is run, and .venv/ would
# appear if a dependency ever arrives and the folder becomes a uv project.
__pycache__/
*.py[cod]
.venv/
venv/

# clangd compile database (machine-specific: absolute paths, local toolchain).
# Regenerate with `bear -- make test`; see CLAUDE.md, Tooling / Editor navigation.
compile_commands.json
.cache/

# The vendored ordering codes (SuiteSparse AMD, Sparspak MMD). Not ours, not published, and
# optional: both builds detect this directory rather than requiring it. See docs/DESIGN_DECISIONS.md.
private/

*.pdf

REPO_MAP.md
reference/
